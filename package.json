{
  "name": "gog-achievements",
  "productName": "GOG Achievements",
  "version": "0.4.0",
  "private": true,
  "description": "Restore GOG achievements you have already earned.",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 0.0.0.0",
    "build:web": "vite build --config vite.web.config.ts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "cli:download": "node scripts/download-cli.mjs",
    "cli:smoke": "node scripts/smoke-cli.mjs",
    "ipc:generate": "node scripts/generate-ipc.mjs",
    "pretypecheck": "npm run ipc:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test tests/scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@electron-ipc-bridge/core": "0.1.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@tanstack/react-virtual": "3.14.20",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron-ipc-bridge/vite-plugin": "0.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opista/gog-achievements.git"
  }
}
